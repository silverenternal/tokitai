# Tokitai 示例环境变量配置

# ==================== Ollama 云服务 ====================
# 从 https://ollama.com/settings/keys 获取 API Key
# 从 https://ollama.com/api/tags 查看可用模型

# Ollama 云服务地址（不要用 /v1 结尾）
OLLAMA_BASE_URL=https://ollama.com

# 模型名称（可用模型：qwen3.5:397b, deepseek-v3.2, gemma3:27b, 等）
OLLAMA_MODEL=qwen3.5:397b

# API Key（从 https://ollama.com/settings/keys 获取）
OLLAMA_API_KEY=your_ollama_api_key_here

# 是否启用（设为 true 启用在线服务）
OLLAMA_ENABLED=true


# ==================== Ollama 本地服务（可选） ====================
# 如果要用本地服务，注释上面，取消下面注释
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2
# OLLAMA_API_KEY=
# OLLAMA_ENABLED=false
