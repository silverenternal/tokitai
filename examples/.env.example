# Tokitai 示例环境变量配置
# 复制此文件为 .env 并填入你的实际配置

# Ollama API 配置
# Ollama 本地服务地址，默认 http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama 模型名称
# 可选：llama2, mistral, codellama 等
# 使用 ollama pull <model> 安装模型
OLLAMA_MODEL=llama2

# 是否启用 Ollama 集成
# 设置为 false 时使用离线演示模式
OLLAMA_ENABLED=false
