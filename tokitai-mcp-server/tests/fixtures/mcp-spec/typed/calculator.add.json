{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "tool_name": "add",
  "description": "Add two 32-bit signed integers and return the sum.",
  "input_schema": {
    "type": "object",
    "properties": {
      "a": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
      "b": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
    },
    "required": ["a", "b"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "integer",
    "minimum": -2147483648,
    "maximum": 2147483647
  }
}